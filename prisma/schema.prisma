// LOCAL DEVELOPMENT: Uses SQLite
// For Vercel + Neon deployment: use prisma/schema.neon.prisma
// Run: bun run deploy:setup (copies Neon schema and regenerates client)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PriceRecord {
  id              String   @id @default(cuid())
  symbol          String
  price           Float
  currency        String
  change          Float?
  source          String?
  buyPrice        Float?
  sellPrice       Float?
  sellWorkmanship Float?
  buyWorkmanship  Float?
  changeAmount    Float?
  createdAt       DateTime @default(now())
}

model AppConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model NotificationLog {
  id      String   @id @default(cuid())
  type    String
  title   String
  message String
  sentAt  DateTime @default(now())
  success Boolean
  error   String?
}

model TelegramUser {
  id        String   @id @default(cuid())
  name      String
  botToken  String
  chatId    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chatId, botToken])
}
