// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PriceRecord {
  id              String   @id @default(cuid())
  symbol          String   // "GOLD_EGP", "USD_EGP", "GOLD_POUND_EGP", "GOLD_24K_EGP", etc.
  price           Double
  currency        String   // "EGP"
  change          Double?  // percentage change from previous
  source          String?  // Where the price was fetched from
  buyPrice        Double?  // Price the shop buys from you (for gold)
  sellPrice       Double?  // Price the shop sells to you (for gold)
  sellWorkmanship Double?  // Workmanship fee on sell (صنعة البيع)
  buyWorkmanship  Double?  // Workmanship fee on buy (صنعة الشراء)
  changeAmount    Double?  // Absolute change amount (e.g., -10.48)
  createdAt       DateTime @default(now())
}

model AppConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model NotificationLog {
  id      String   @id @default(cuid())
  type    String   // "daily_report", "buy_signal", "usd_drop_alert", "test"
  title   String
  message String
  sentAt  DateTime @default(now())
  success Boolean
  error   String?
}

model TelegramUser {
  id        String   @id @default(cuid())
  name      String   // Display name for the user
  botToken  String   // Unique Telegram Bot Token for this user
  chatId    String   // Unique Chat ID for this user
  active    Boolean  @default(true) // Whether to send notifications to this user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
